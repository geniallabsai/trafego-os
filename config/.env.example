# =============== TRAFEGO-OS — CHAVES & TOKENS ===============
# Como usar:  cp config/.env.example config/.env  e preencha.
# O .env NUNCA vai pro git (veja .gitignore). Aperte as chaves depois de usar em canal aberto.
#
# FASE 1 (leitura): preencha só *_READ/SYSTEM_USER + LLM -> o time analisa, prevê e relata.
# FASE 2 (escrita): libere *_WRITE quando o agente 00 (Head) ganhar permissão de execução.

# ---------- GitHub (este repositório: pull/push de artefatos) ----------
GITHUB_TOKEN=

# ---------- LLM (criativos, copy, análise — agentes 02, 03, 05, 06, 07, 08, 09, 10, 11) ----------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
TRAFEGO_LLM_PROVIDER=openai              # openai | anthropic | openrouter
TRAFEGO_LLM_MODEL=gpt-4o                 # modelo padrão (ajuste ao que você assina)
TRAFEGO_LLM_TEMP_CRIATIVO=0.9            # geração de criativos/copy: quente
TRAFEGO_LLM_TEMP_ANALISE=0.2             # análise de dados/forecast: fria

# ---------- Meta (Facebook/Instagram) ----------
META_SYSTEM_USER_TOKEN=                  # leitura: insights/campanhas/criativos (02, 04, 11, 12, 13)
META_WRITE_TOKEN=                        # escrita: budget/status/novo ad — FASE 2 (00)
META_BUSINESS_ID=
META_AD_ACCOUNT_ID=                      # act_XXXXXXXXXX
META_PIXEL_ID=

# ---------- Google Ads ----------
GOOGLE_DEVELOPER_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_CUSTOMER_ID=                      # MCC ou conta (sem traços)

# ---------- TikTok Ads ----------
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=

# ---------- Auxiliares ----------
GA4_MEASUREMENT_ID=                      # opcional: funil AAAR no site
ERP_WEBHOOK_URL=                         # opcional: pedidos/sales para revenue real
FX_USD_BRL=5.43                          # atualizar mensalmente (ingest.py --fx)
